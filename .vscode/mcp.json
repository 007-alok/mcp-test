{
	"servers": {
		"github": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-github@2025.4.8"
			],
			"env": {
				"GITHUB_PERSONAL_ACCESS_TOKEN": "${input:github_pat}"
			},
			"type": "stdio"
		}
	},
	"inputs": [
		{
			"id": "token",
			"type": "promptString",
			"description": "GitHub Personal Access Token (GITHUB_PERSONAL_ACCESS_TOKEN)"
		}
	]
}